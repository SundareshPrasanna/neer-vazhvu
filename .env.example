# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI narratives (scripts/generate-narratives.ts)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Citizen reports (/for-citizens). Off unless NEXT_PUBLIC_CITIZEN_REPORTS=on; see docs/architecture/citizen-reports.md.
NEXT_PUBLIC_CITIZEN_REPORTS=
# HMAC key for reporter tags: openssl rand -hex 32. Never change once live.
SIGHTINGS_REPORTER_KEY_SECRET=
# Comma-separated Supabase auth user ids allowed to review.
SIGHTINGS_REVIEWER_IDS=
# Signs each department's private status link: openssl rand -hex 32. Changing it replaces every link.
SIGHTINGS_DEPARTMENT_LINK_SECRET=
# Opt-in browser notifications (web-push VAPID pair). The public key is read at build time.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@neervazhvu.org
# Shared with the GitHub workflows that call /api/cron/* (same value as the CRON_SECRET repository secret).
CRON_SECRET=
