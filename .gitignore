# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase temp files
supabase/.temp/

# GEE service account keys
/motiveloop-play-*.json

# GEE research/planning docs (local reference only)
GEE_*.md

# CPCB annual report PDFs - downloaded by user, parsed by
# neer-vazhvu-api/scripts/scrape_cpcb_nwmp_vaigai.py
docs/cpcb/*.pdf

# Local caches written by data-acquisition scripts
scripts/_cache-*.json
# Raw API/PDF pulls cached so re-runs skip the download (81 MB for Delhi's
# 278k WRIS groundwater rows). Rebuildable: `--refresh` re-downloads.
neer-vazhvu-api/scripts/.cache/

# Raw upstream PDFs pulled by hand for the Parivesh EC pilot (19 SEIAA letters,
# 17 MB). Ignored as a LICENCE guardrail, not as build config: the Parivesh
# licence is UNVERIFIED, so we have no established right to redistribute these
# documents, and the mirrored-document gate only scans public/docs. They are the
# evidence behind input_digests and are re-retrievable from
# parivesh.nic.in; the digests are what let anyone confirm the same bytes.
scripts/.cache/

# Rich-body satellite imagery + tints - served from Supabase Storage
# in production via the `satellite-evidence` bucket. Local files are
# kept by the ingest pipeline (scripts/ingest_rich_body_imagery.py
# and the tint scripts) for dev convenience but are excluded from git
# because the bundle exceeds Vercel's practical static-deploy size
# (~150 MB across 14 Bangalore bodies + 7 Chennai bodies). The chip
# url in each <body>-imagery-manifest.json points to the Supabase
# public URL; the local files are a developer-only artifact.
public/data/rich-bodies/imagery/
public/data/rich-bodies/tints/

# Local-only workspace + working-doc directories. Not part of the
# shipped codebase.
.vscode/
docs/deliverables/
# Partnership decks, proposals, call-prep, contact material - private,
# never shipped.
docs/partnerships/

# City-onboarding working docs (intern plans, source workbooks, QC logs) -
# local only, never shipped.
docs/onboarding/

# Parked WIP: partnership decks, reports, research scripts, raw data,
# and draft specs moved out of the working tree. Kept locally for
# reference but excluded from git.
/_parked/

# Office (Word/PowerPoint) temp lock files - never commit these.
~$*

# Specs / design docs are kept local, not tracked in the codebase.
docs/specs/

# Internal working material kept local, not in the public repo:
# research corpora (PDF mirrors of gov/ADB/CGWB docs), partnership
# folders (shared under agreement, not ours to publish), and Paani
# Earth collaboration data.
# (docs/research/* not docs/research/: an ignored DIRECTORY cannot have a
# file negated back inside it. kabini/prs.json publishes the F-register
# counts, so the extraction output that reproduces them stays tracked.)
docs/research/*
!docs/research/kabini-fregister-counts.json
docs/partnerships/
docs/paani_data/

# Python bytecode
scripts/__pycache__/
__pycache__/

# Conference talk decks (local only)
/talks/

# Corpus fetch cache used by scripts/fetch-corpus.sh in CORPUS_SOURCE=remote
# mode (serving-hardening P1). Never committed. The stage/old dirs are
# transient stage-then-swap workspaces; they linger only after a mid-swap
# failure.
.corpus-cache/
public/data.corpus-stage/
public/data.corpus-old/
public/geojson.corpus-stage/
public/geojson.corpus-old/

# Generated freshness / edition reports (CI artifacts, never committed)
freshness-report.md
freshness-keys.json
editions-report.md
editions-report-keys.json
change-report-*.md

# Claude Code session state - only skills are tracked
.claude/*
!.claude/skills/
.cache/
