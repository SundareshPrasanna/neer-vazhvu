# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase temp files
supabase/.temp/

# GEE service account keys
/motiveloop-play-*.json

# GEE docs: track the curated project docs below, ignore other ad hoc notes by default
GEE_*.md
!GEE_CATCHMENT_DERIVATION_PLAN.md
!GEE_PHASE1_METHODS.md
!GEE_PHASE1_PLAN.md
!GEE_RESEARCH.md
!GEE_SATELLITE_EVIDENCE_PLAN.md
!GEE_SATELLITE_EVIDENCE_CHECKLIST.md
