{
  "$id": "ward-profiles.schema.json",
  "title": "data-root/ward-profiles contract (Tier A)",
  "description": "Per-ward water profile. NVDM form is WRAPPED (envelope + wards[]); the legacy bare-array files are grandfathered until migrated (spec 6.1, 9.3). City-specific ward attributes (electoral rolls, populations) live in ext or as optional keys, never as core.",
  "allOf": [{ "$ref": "envelope.schema.json#/$defs/envelope" }],
  "type": "object",
  "required": ["wards"],
  "properties": {
    "wards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["ward_number", "area_sq_km", "centroid"],
        "properties": {
          "ward_number": { "type": "integer" },
          "ward_name": { "type": "string" },
          "zone_name": { "type": ["string", "null"] },
          "zone_no": { "type": ["integer", "string", "null"] },
          "area_sq_km": { "type": "number" },
          "centroid": { "type": ["array", "object"] },
          "water_bodies": { "type": ["array", "object", "integer"] },
          "lost_bodies": { "type": ["array", "object", "integer"] },
          "rivers": { "type": ["array", "object"] },
          "drainage": { "type": ["string", "object", "null"] },
          "sewerage": { "type": ["string", "object", "null"] },
          "flood": { "type": ["string", "object", "null"] },
          "industrial": { "type": ["array", "object", "null"] },
          "groundwater_assessment": { "type": ["string", "object", "null"] }
        }
      }
    }
  }
}
