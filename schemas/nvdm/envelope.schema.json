{
  "$id": "envelope.schema.json",
  "title": "NVDM v1 envelope",
  "description": "Identity + provenance wrapper every NVDM artifact carries (docs/specs/nvdm-v1.md Part 5). Object artifacts carry these keys at top level; GeoJSON FeatureCollections carry them as RFC 7946 foreign members.",
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}(-\\d{2})?(-\\d{2})?$",
      "description": "ISO 8601 date, year-month, or year. Never prose."
    },
    "scope": {
      "type": "object",
      "required": ["kind", "id"],
      "properties": {
        "kind": {
          "enum": ["city", "region", "basin", "corridor", "district", "state", "body"]
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "Registered scope id (spec 4.1). Stable forever; no hierarchy encoded."
        }
      }
    },
    "source": {
      "type": "object",
      "required": ["title", "publisher"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Headwaters source-registry id. REQUIRED for living sources (anything that could publish again)."
        },
        "title": { "type": "string" },
        "publisher": { "type": "string" },
        "url": { "type": "string" },
        "license": {
          "type": "string",
          "description": "REQUIRED when the artifact redistributes the source's values (spec Part 5)."
        },
        "as_of": { "$ref": "#/$defs/date" },
        "retrieved": { "$ref": "#/$defs/date" }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["sources", "method", "produced_at"],
      "properties": {
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/source" }
        },
        "method": {
          "enum": ["manual", "scrape", "api", "pdf-extract", "gee", "derived", "mixed"]
        },
        "produced_at": { "$ref": "#/$defs/date" },
        "produced_by": {
          "type": "string",
          "description": "Generator script path, or \"manual\"."
        },
        "note": { "type": ["string", "array"] },
        "conventions": {
          "type": "object",
          "description": "Declared traps: sign conventions, aggregation basis, comparability breaks (spec 7.5)."
        }
      }
    },
    "envelope": {
      "type": "object",
      "required": ["nvdm", "dataset", "scope", "provenance"],
      "properties": {
        "nvdm": { "type": "string", "pattern": "^1\\.\\d+$" },
        "dataset": {
          "type": "string",
          "pattern": "^[a-z-]+/[a-z0-9-]+$",
          "description": "<family>/<stem>, must agree with the file path."
        },
        "scope": { "$ref": "#/$defs/scope" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "ext": {
          "type": "object",
          "description": "Per-scope extensions, namespaced by concern (spec 6.3)."
        }
      }
    }
  }
}
