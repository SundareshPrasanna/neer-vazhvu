{
  "$id": "commitments.schema.json",
  "title": "data-root/commitments contract (Tier A)",
  "description": "Promise tracker. Statuses change only with a dated citation; history is append-only (the update_model discipline, now contract).",
  "allOf": [{ "$ref": "envelope.schema.json#/$defs/envelope" }],
  "type": "object",
  "required": ["commitments", "status_legend", "update_model"],
  "properties": {
    "update_model": { "type": "string" },
    "status_legend": { "type": "object" },
    "headline": { "type": "string" },
    "intro": { "type": "string" },
    "sources_note": { "type": "string" },
    "commitments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "what", "status", "due", "status_history"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "what": { "type": "string" },
          "category": { "type": "string" },
          "committed_by": { "type": "string" },
          "commitment_source": { "type": ["string", "object"] },
          "source_ids": {
            "type": "array",
            "items": { "type": "string" },
            "description": "CLAIM DATASET: every commitment MUST carry commitment_source, source_ids, or inline sources (spec 5.1)."
          },
          "sources": {
            "type": "array",
            "items": { "$ref": "envelope.schema.json#/$defs/source" }
          },
          "due": { "type": ["string", "null"] },
          "revised_due": { "type": ["string", "null"] },
          "next_check": { "type": ["string", "null"] },
          "status": { "type": "string" },
          "status_history": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["date", "status"],
              "properties": {
                "date": { "$ref": "envelope.schema.json#/$defs/date" },
                "status": { "type": "string" },
                "note": { "type": "string" },
                "source_label": { "type": "string" },
                "source_url": { "type": ["string", "null"] }
              }
            },
            "description": "Append-only. Every entry requires a date and a citation (source_label or source_url - enforced by the validator's claim check); may be empty only for a commitment with no status changes since creation."
          }
        }
      }
    }
  }
}
