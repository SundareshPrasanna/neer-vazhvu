{
  "$id": "restoration-priority.schema.json",
  "title": "data-root/restoration-priority contract (Tier A)",
  "description": "Derived restoration scoring. weights + algorithm identity are part of the record because a score without its formula is not citable; produced_by in the envelope names the generator.",
  "allOf": [{ "$ref": "envelope.schema.json#/$defs/envelope" }],
  "type": "object",
  "required": ["water_bodies", "weights"],
  "properties": {
    "algorithm_version": { "type": ["string", "integer"] },
    "weights": { "type": "object" },
    "total_scored": { "type": "integer" },
    "notes": { "type": ["string", "array"] },
    "river_sections": { "type": "array", "items": { "type": "object" } },
    "water_bodies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "priority_score", "priority_level"],
        "properties": {
          "id": { "type": ["string", "integer"] },
          "osm_id": { "type": ["integer", "string", "null"], "description": "null = scored body with no OSM match" },
          "census_id": { "type": ["string", "integer", "null"] },
          "name": { "type": ["string", "null"] },
          "area_ha": { "type": "number" },
          "water_type": { "type": "string" },
          "priority_score": { "type": "number" },
          "priority_level": { "type": "string" },
          "components": { "type": "object" },
          "rationale": { "type": "string" },
          "centroid": { "type": ["array", "object"] }
        }
      }
    }
  }
}
