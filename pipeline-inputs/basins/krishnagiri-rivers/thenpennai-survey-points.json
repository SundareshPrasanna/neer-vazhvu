 "ngt2020": {
  "sampledOn": "2020-09-09/2020-09-10",
  "sampledBy": "NGT joint committee (CPCB, KSPCB, TNPCB and the departments named in the order of 20.07.2020), following CPCB's NWMP standard operating procedure (August 2017)",
  "classKey": {
   "A": "Drinking water source without conventional treatment but after disinfection",
   "B": "Outdoor bathing (organised)",
   "C": "Drinking water source after conventional treatment and disinfection",
   "D": "Propagation of wild life and fisheries",
   "E": "Irrigation, industrial cooling, controlled waste disposal"
  },
  "reportFindings": [
   "Dissolved oxygen above 4 mg/L only at the Kelavarapalli reservoir, its outfall, the Y junction and the Bellandur diversion channel; the river is oxygen-depleted from Channasandra bridge to Bagalur bridge (section 5.2).",
   "BOD fails the designated-best-use criteria at every sampled location; at Bagalur bridge (53 mg/L) it exceeds even the general effluent discharge standard (section 5.2).",
   "Anionic surfactants were found only at Sokkarasanapalli and Bagalur bridge (section 5.2; Table 2 prints 0.34 and 0.43 mg/L).",
   "Iron above the permissible level at Mugalur bridge, Sokkarasanapalli, Bagalur and Kodiyalam; zinc at Channasandra bridge and Kelavarapalli; mercury in Bellandur lake (0.012 mg/L) (section 5.2, Table 3).",
   "No pesticide traces at any location (section 5.2).",
   "Rainfall of more than 100 mm fell on the night before sampling, 9 September 2020 (section 5.2)."
  ],
